# Copy to repro/env (gitignored) and fill in. Everything environment-specific lives here; the scripts never need editing.
# Entra tenant, client IDs, secrets and test users come from entra/.state.env (written by entra/setup.sh), so they are not repeated here.
# Run from a host that may reach the broker, the gateway and login.microsoftonline.com (needs curl, jq, node 18+, az, npm ci in broker/).

# Required: the broker's base URL, without /token/exchange (terraform output exchange_url minus the suffix)
BROKER_URL=             # https://<container-app>.<env>.<region>.azurecontainerapps.io
# Required for the gateway scenarios (empty = those scenarios stop with SKIP)
GATEWAY_URL=            # https://<gateway host>, no trailing slash
GATEWAY_MODEL=          # model name sent in the request; the mock upstream ignores it, default claude-3-haiku

# Expected values, matching the policy that gateway/setup.sh wrote to infra/policy.auto.tfvars
FINANCE_WORKSPACE=      # workspace slug, for example ws-finance-1a2b3c
FINANCE_CONFIG_SLUG=    # config b in that workspace (the hybrid gateway reads defaults.config_slug and ignores config_id)
HR_WORKSPACE=           # workspace slug, for example ws-hr-4d5e6f
HR_CONFIG_SLUG=         # config c in that workspace
# Which fallback target answers (x-portkey-last-used-option-index): config b = 1, config c = 2, workspace default config a = 0
FINANCE_OPTION_INDEX=1
HR_OPTION_INDEX=2

# Optional
GATEWAY_VERSION=        # recorded in each summary, for example 2.29.0
KEY_VAULT_NAME=         # terraform output key_vault_name (rotation scenario)
KEY_NAME=portkey-signing-key
JIT_USER_ACCESS=off     # mirrors the gateway's JWT_JIT_USER_ACCESS. off: user (ROPC) tokens of non-members get 403 code 033. on: admitted as a workspace service key, 200
